{
  "name": "ui",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && tsx scripts/workspace-language-check.ts && biome check src scripts vite.config.ts",
    "format": "biome check --write src scripts vite.config.ts",
    "test": "vitest run",
    "probe": "tsx scripts/terminal-probe.ts",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@radix-ui/colors": "3.0.0",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.5"
  }
}
